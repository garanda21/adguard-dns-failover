# --- AdGuard Home instances (add as many as you need: 1, 2, 3...) ---
ADGUARD_1_URL=http://192.168.1.2:3000
ADGUARD_1_NAME=Casa
ADGUARD_1_USER=admin
ADGUARD_1_PASSWORD=changeme
# ADGUARD_1_PASSWORD_FILE=/run/secrets/adguard_1_password

# ADGUARD_2_URL=http://192.168.1.3:3000
# ADGUARD_2_USER=admin
# ADGUARD_2_PASSWORD=changeme

# --- Pi-hole v6 instances (optional, can be mixed with AdGuard) ---
# PIHOLE_1_URL=http://192.168.1.10
# PIHOLE_1_NAME=Pi-hole NAS
# PIHOLE_1_PASSWORD=app-password   # Settings > Web interface / API > App password
# App passwords need webserver.api.app_sudo enabled in Pi-hole (or FTLCONF_webserver_api_app_sudo=true)
# Do NOT set FTLCONF_dns_upstreams in Pi-hole: it makes upstreams read-only for the API
# PIHOLE_1_PASSWORD_FILE=/run/secrets/pihole_1_password
# PIHOLE_1_VERIFY_SSL=false        # self-signed certificate with https://

# --- Schedules (cron expressions separated by ';') ---
# Mon-Fri every 4 hours; Sat-Sun every 2 hours
CRON_SCHEDULES=0 */4 * * 1-5;0 */2 * * 6,0
RUN_ON_START=true
TZ=Europe/Madrid

# --- Detection ---
# Block if any ISP has >= BLOCK_MIN_IPS blocked IPs OR >= BLOCK_THRESHOLD_PCT %
BLOCK_MIN_IPS=20
# Only check these ISPs (comma separated, case-insensitive). Empty = all.
# Available: DIGI, Masmovil, Movistar, Orange, Vodafone
# ISPS=movistar
BLOCK_THRESHOLD_PCT=50
# API_URL=https://hayahora.futbol/estado/data.json

# --- DNS to use while blocked, separated by ';' (default: xdp.es) ---
BLOCK_UPSTREAMS=https://dns.xdp.es/dns-query;tls://dns.xdp.es
BLOCK_BOOTSTRAP=85.208.114.51;51.170.52.10
# Pi-hole only supports plain DNS (IP or IP#port), no DoH/DoT
# BLOCK_PIHOLE_UPSTREAMS=85.208.114.51;51.170.52.10
# Fallback DNS during block (defaults to BLOCK_UPSTREAMS; 'none' = don't touch)
# BLOCK_FALLBACK=
# BLOCK_UPSTREAM_MODE=load_balance

# --- Telegram notifications (optional) ---
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_STARTUP_MESSAGE=true   # 'all good' summary at startup (errors are always sent)

DRY_RUN=false
LOG_LEVEL=INFO
